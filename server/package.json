{
  "name": "server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "seed": "tsx --env-file-if-exists=../.env src/scripts/seed.ts",
    "db:migrate": "tsx --env-file-if-exists=../.env src/scripts/migrate.ts",
    "create-user": "tsx --env-file-if-exists=../.env src/scripts/create-user.ts",
    "db:push": "cd ../drizzle && npx drizzle-kit push",
    "db:studio": "cd ../drizzle && npx drizzle-kit studio"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.90.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "drizzle": "workspace:*",
    "express": "^4.21.1",
    "express-rate-limit": "^7.5.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^8.0.5",
    "shared": "workspace:*",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.16.5",
    "@types/nodemailer": "^8.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  }
}
