# ============================================
# CRM Support Portal - Environment Variables
# ============================================

# --- Server (Required for server/) ---
DATABASE_URL=postgresql://user:password@localhost:5432/support_portal
# Signs admin session cookies. Required in production (32+ chars):
#   openssl rand -base64 32
JWT_SECRET=
NODE_ENV=development
PORT=3001

# --- First admin account ---
# Created automatically on startup when no login accounts exist yet.
# Password must be at least 12 characters.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# --- CRM webhook (Optional) ---
# When set, POST /webhook/stage-change requires header X-Webhook-Secret.
WEBHOOK_SECRET=

# --- AI Chat (Required for /api/chat) ---
# Get a key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# --- Outbound Email (Required for ticket-closed notifications) ---
# Any SMTP provider works (Gmail app-password, SendGrid, Postmark,
# Mailgun, Amazon SES, Resend, etc). Leave blank to skip sending.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=support@example.com

# --- Server (Optional) ---
FRONTEND_URL=http://localhost:5173

# --- Client (Optional) ---
VITE_API_URL=http://localhost:3001
